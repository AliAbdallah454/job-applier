FROM ghcr.io/astral-sh/uv:0.12.23 AS uv

FROM python:3.12-slim

COPY --from=uv /uv /usr/local/bin/uv

WORKDIR /app

# HOME points at /tmp because the root file system is read-only in the cluster and TeX and
# fontconfig write their caches under it.
ENV UV_LINK_MODE=copy PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp

# The same TeX as the document worker, for compiling a user's edits, plus synctex for previews.
RUN apt-get update \
    && apt-get install -y --no-install-recommends texlive-xetex texlive-latex-extra \
       texlive-fonts-recommended \
       fonts-dejavu-core fonts-lmodern lmodern \
    && kpsewhich marvosym.sty > /dev/null \
    && kpsewhich lmodern.sty > /dev/null \
    && command -v synctex > /dev/null \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml uv.lock ./

RUN --mount=type=secret,id=build_ca \
    if [ -f /run/secrets/build_ca ]; then export SSL_CERT_FILE=/run/secrets/build_ca; fi; \
    uv sync --locked --no-dev --group api --no-install-project --system-certs

COPY backend/ ./backend/

USER 10001:10001

EXPOSE 8000

ENTRYPOINT ["/app/.venv/bin/python", "-m", "backend.api"]

# Binding beyond localhost makes the API refuse to start without the AUTH0_* values.
CMD ["--host", "0.0.0.0", "--port", "8000"]
